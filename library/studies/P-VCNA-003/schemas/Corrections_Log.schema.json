{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corrections_Log v2.4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "correction_id": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "changed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "source_basis": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "exact_text": {
                  "type": "string"
                },
                "source_regions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "document_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pdf_page": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "bbox": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0
                        },
                        "minItems": 4,
                        "maxItems": 4
                      },
                      "coordinate_system": {
                        "const": "pdf_points_top_left"
                      }
                    },
                    "required": [
                      "document_id",
                      "pdf_page",
                      "bbox",
                      "coordinate_system"
                    ]
                  },
                  "minItems": 0
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "exact_text",
                "source_regions",
                "notes"
              ]
            },
            "minItems": 0
          },
          "checks_to_rerun": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "correction_id",
          "template_id",
          "reason",
          "changed_paths",
          "source_basis",
          "checks_to_rerun"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "corrections"
  ]
}
