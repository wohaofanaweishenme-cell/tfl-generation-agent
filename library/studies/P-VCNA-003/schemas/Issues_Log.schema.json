{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issues_Log v2.4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "stage": {
      "enum": [
        "identification",
        "structure",
        "docx",
        "metadata",
        "qa"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "deferred"
            ]
          },
          "source_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "coordinate_system": {
                  "const": "pdf_points_top_left"
                }
              },
              "required": [
                "document_id",
                "pdf_page",
                "bbox",
                "coordinate_system"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "issue_id",
          "template_id",
          "severity",
          "category",
          "description",
          "status",
          "source_regions"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "stage",
    "issues"
  ]
}
