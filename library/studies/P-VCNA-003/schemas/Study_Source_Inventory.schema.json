{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study_Source_Inventory v2.4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "file_path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sap",
              "shells",
              "content_list"
            ]
          },
          "format": {
            "enum": [
              "pdf",
              "docx"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "document_id",
          "file_path",
          "kind",
          "format",
          "sha256",
          "version"
        ]
      },
      "minItems": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "sources",
    "notes"
  ]
}
