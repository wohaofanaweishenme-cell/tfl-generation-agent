{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extraction_Progress v2.4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "identification",
        "structure",
        "docx",
        "metadata",
        "qa"
      ]
    },
    "manifest_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "completed_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "remaining_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "blocked_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "identification_complete": {
      "type": "boolean"
    },
    "full_study_complete": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "stage",
    "manifest_ids",
    "completed_ids",
    "remaining_ids",
    "blocked_ids",
    "identification_complete",
    "full_study_complete",
    "notes"
  ]
}
