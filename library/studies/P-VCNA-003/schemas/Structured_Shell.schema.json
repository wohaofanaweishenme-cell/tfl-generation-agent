{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured_Shell v2.4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "output_type": {
      "enum": [
        "table",
        "figure",
        "listing"
      ]
    },
    "structural_family": {
      "enum": [
        "table",
        "figure",
        "listing"
      ]
    },
    "extraction_status": {
      "enum": [
        "complete",
        "needs_review",
        "blocked"
      ]
    },
    "source_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "coordinate_system": {
            "const": "pdf_points_top_left"
          }
        },
        "required": [
          "document_id",
          "pdf_page",
          "bbox",
          "coordinate_system"
        ]
      },
      "minItems": 0
    },
    "source_docx_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "location"
        ]
      },
      "minItems": 0
    },
    "physical_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "title",
              "body",
              "footnote",
              "programming_note",
              "source_line",
              "placeholder",
              "image",
              "code",
              "other"
            ]
          },
          "display_order": {
            "type": "integer",
            "minimum": 0
          },
          "panel_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "coordinate_system": {
                  "const": "pdf_points_top_left"
                }
              },
              "required": [
                "document_id",
                "pdf_page",
                "bbox",
                "coordinate_system"
              ]
            },
            "minItems": 0
          },
          "source_docx_location": {
            "type": [
              "string",
              "null"
            ]
          },
          "exact_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_element_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "block_id",
          "kind",
          "display_order",
          "panel_id",
          "source_regions",
          "source_docx_location",
          "exact_text",
          "source_element_ids",
          "notes"
        ]
      },
      "minItems": 0
    },
    "source_elements": {
      "type": "array",
      "description": "Logical source elements, including observations not yet designated editable. Membership in one element must be justified semantically, never by equal strings alone. IDs are unique within template. Actual visible content must be covered; empty arrays require explicit pending/coverage issue.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "element_id": {
            "type": "string",
            "minLength": 1
          },
          "element_type": {
            "type": "string",
            "minLength": 1
          },
          "metadata_pointer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pointer within this template to the corresponding source fact."
          },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "occurrence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "docx_locator": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Real bookmark/content-control locator; null for an unlocated/noneditable occurrence."
                },
                "source_text": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Verbatim text of this occurrence. Null only when unreadable/nontextual, with an issue."
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "panel_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_ref_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "verification_status": {
                  "enum": [
                    "verified",
                    "unverified",
                    "noneditable"
                  ]
                }
              },
              "required": [
                "occurrence_id",
                "docx_locator",
                "source_text",
                "role",
                "panel_id",
                "source_ref_ids",
                "verification_status"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "verification_status": {
                        "const": "verified"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "docx_locator": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "docx_locator"
                    ]
                  }
                }
              ]
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "element_id",
          "element_type",
          "metadata_pointer",
          "occurrences",
          "notes"
        ]
      }
    },
    "occurrence_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relation_id": {
            "type": "string",
            "minLength": 1
          },
          "from_occurrence_id": {
            "type": "string",
            "minLength": 1
          },
          "to_occurrence_id": {
            "type": "string",
            "minLength": 1
          },
          "relation_type": {
            "enum": [
              "exact_repeat",
              "related_distinct",
              "uncertain"
            ]
          },
          "review_status": {
            "enum": [
              "pending",
              "verified",
              "conflicting"
            ]
          },
          "source_ref_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "relation_id",
          "from_occurrence_id",
          "to_occurrence_id",
          "relation_type",
          "review_status",
          "source_ref_ids",
          "note"
        ]
      },
      "description": "Within-template observations only. No replacement or synchronization is triggered. exact_repeat requires identical source text; text variants affecting meaning remain distinct elements."
    },
    "footnotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "footnote_id": {
            "type": "string"
          },
          "marker": {
            "type": [
              "string",
              "null"
            ]
          },
          "exact_text": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "study_specific",
              "template_convention",
              "placeholder"
            ]
          },
          "display_order": {
            "type": "integer",
            "minimum": 0,
            "description": "0-based physical order of distinct footnotes within this source shell"
          },
          "applies_to_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "description": "Typed link from source footnote marker to visible shell element; a missing association is unresolved, never guessed.",
              "required": [
                "target_type",
                "target_id",
                "panel_id",
                "mapping_status"
              ],
              "properties": {
                "target_type": {
                  "enum": [
                    "shell",
                    "row",
                    "column",
                    "cell",
                    "panel",
                    "figure_axis",
                    "figure_legend",
                    "unknown"
                  ]
                },
                "target_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "row/column/panel ID; cell uses row_id:column_id; axis uses panel_id:x or panel_id:y; null for shell/unknown."
                },
                "panel_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mapping_status": {
                  "enum": [
                    "explicit",
                    "inferred",
                    "unresolved"
                  ]
                }
              }
            },
            "description": "Typed footnote marker-to-row/column/cell/panel associations; [] requires a review issue unless truly global."
          },
          "semantic_extraction_status": {
            "enum": [
              "extracted",
              "no_rule_identified",
              "needs_review",
              "unreadable"
            ],
            "description": "extracted includes abbreviation and display conventions as well as statistical rules; no_rule_identified requires explicit inspection, not merely an empty array."
          },
          "semantic_rules": {
            "type": "array",
            "description": "One note may express multiple independent semantic rules; rule scopes inherit footnote applies_to_refs unless overridden.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule_id",
                "rule_type",
                "normalized_rule",
                "rule_status",
                "evidence_ref_ids"
              ],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "rule_type": {
                  "enum": [
                    "denominator",
                    "population_definition",
                    "statistical_method",
                    "counting_rule",
                    "missing_data",
                    "coding_definition",
                    "abbreviation",
                    "display_convention",
                    "inclusion_exclusion",
                    "other"
                  ]
                },
                "normalized_rule": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Faithful paraphrase of source rule, not a default for target studies; null if unresolved."
                },
                "rule_status": {
                  "enum": [
                    "explicit",
                    "inferred",
                    "conflicting",
                    "unresolved"
                  ]
                },
                "adaptation_field": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The target-SAP requirement to check before adapting; not an unverified target Specification JSON Pointer."
                },
                "evidence_ref_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "applies_to_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Typed link from source footnote marker to visible shell element; a missing association is unresolved, never guessed.",
                    "required": [
                      "target_type",
                      "target_id",
                      "panel_id",
                      "mapping_status"
                    ],
                    "properties": {
                      "target_type": {
                        "enum": [
                          "shell",
                          "row",
                          "column",
                          "cell",
                          "panel",
                          "figure_axis",
                          "figure_legend",
                          "unknown"
                        ]
                      },
                      "target_id": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "row/column/panel ID; cell uses row_id:column_id; axis uses panel_id:x or panel_id:y; null for shell/unknown."
                      },
                      "panel_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "mapping_status": {
                        "enum": [
                          "explicit",
                          "inferred",
                          "unresolved"
                        ]
                      }
                    }
                  },
                  "description": "Optional narrower rule scope; if omitted, inherit the footnote scope."
                }
              }
            }
          },
          "evidence_ref_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "Links to source_shell evidence; cross-validated against provenance.evidence."
          }
        },
        "additionalProperties": false,
        "required": [
          "footnote_id",
          "marker",
          "exact_text",
          "applies_to",
          "category",
          "display_order",
          "applies_to_refs",
          "semantic_extraction_status",
          "semantic_rules",
          "evidence_ref_ids"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "semantic_extraction_status": {
                  "const": "extracted"
                }
              }
            },
            "then": {
              "properties": {
                "semantic_rules": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "semantic_extraction_status": {
                  "const": "no_rule_identified"
                }
              }
            },
            "then": {
              "properties": {
                "semantic_rules": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "programming_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "exact_text": {
            "type": "string"
          },
          "source_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "coordinate_system": {
                  "const": "pdf_points_top_left"
                }
              },
              "required": [
                "document_id",
                "pdf_page",
                "bbox",
                "coordinate_system"
              ]
            },
            "minItems": 0
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "exact_text",
          "source_regions",
          "notes"
        ]
      },
      "minItems": 0
    },
    "listing_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "panel_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "order",
          "panel_id",
          "notes"
        ]
      },
      "minItems": 0
    },
    "physical_cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "panel_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "row_id": {
            "type": "string",
            "minLength": 1
          },
          "column_id": {
            "type": "string",
            "minLength": 1
          },
          "row_span": {
            "type": "integer",
            "minimum": 1
          },
          "column_span": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_blank": {
            "type": "boolean"
          },
          "source_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "coordinate_system": {
                  "const": "pdf_points_top_left"
                }
              },
              "required": [
                "document_id",
                "pdf_page",
                "bbox",
                "coordinate_system"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "cell_id",
          "panel_id",
          "row_id",
          "column_id",
          "row_span",
          "column_span",
          "text",
          "is_blank",
          "source_regions"
        ]
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "deferred"
            ]
          },
          "source_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "coordinate_system": {
                  "const": "pdf_points_top_left"
                }
              },
              "required": [
                "document_id",
                "pdf_page",
                "bbox",
                "coordinate_system"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "issue_id",
          "template_id",
          "severity",
          "category",
          "description",
          "status",
          "source_regions"
        ]
      },
      "minItems": 0
    },
    "table_spec": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "section",
                  "subsection",
                  "variable",
                  "category",
                  "statistic",
                  "spacer",
                  "other"
                ]
              },
              "statistic": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "placeholder": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "editable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "order",
              "parent_id",
              "label",
              "role",
              "statistic",
              "placeholder",
              "editable"
            ]
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "stub",
                  "arm",
                  "timepoint",
                  "statistic",
                  "group_header",
                  "identifier",
                  "other"
                ]
              },
              "placeholder": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "editable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "order",
              "parent_id",
              "label",
              "role",
              "placeholder",
              "editable"
            ]
          }
        },
        "statistics": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Preserve source spellings; e.g. n (%), mean (SD)"
          }
        },
        "denominator_rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional general source-summary only. Multiple row/cell-specific denominators MUST be captured in footnotes[].semantic_rules and applies_to_refs; do not overwrite with one global string."
        },
        "cell_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "row_id": {
                "type": "string"
              },
              "column_id": {
                "type": "string"
              },
              "display_format": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "placeholder": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rule_description": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "row_id",
              "column_id",
              "display_format",
              "placeholder",
              "rule_description"
            ]
          }
        },
        "header_row_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "merged_cell_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape",
            "unspecified"
          ]
        },
        "layout_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
