{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source_Locator_Checks v2.4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "layer": {
            "enum": [
              "contract",
              "docx",
              "visual",
              "semantic",
              "approval"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "needs_review",
              "not_run"
            ]
          },
          "details": {
            "type": "string"
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "check_id",
          "template_id",
          "layer",
          "status",
          "details",
          "evidence_paths"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "checks"
  ]
}
