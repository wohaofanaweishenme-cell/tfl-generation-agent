therapy cycle will be\nused for analysis.","role":"footnote","panel_id":"P118","source_ref_ids":["EV00038"],"verification_status":"verified"}],"notes":"Native source occurrence; actual static and visual checks separate."},{"element_id":"E00039","element_type":"programming_note","metadata_pointer":null,"occurrences":[{"occurrence_id":"E00039O","docx_locator":"bookmark:E00039","source_text":"Programming notes: For visit  of GRAN®, please specify the day of visit rather than  list ‘4-21 days’.","role":"programming_note","panel_id":"P118","source_ref_ids":["EV00039"],"verification_status":"verified"}],"notes":"Native source occurrence; actual static and visual checks separate."},{"element_id":"E00040","element_type":"programming_note","metadata_pointer":null,"occurrences":[{"occurrence_id":"E00040O","docx_locator":"bookmark:E00040","source_text":"Programming notes: relative dose intensity (%) is rounded to integer.","role":"programming_note","panel_id":"P118","source_ref_ids":["EV00040"],"verification_status":"verified"}],"notes":"Native source occurrence; actual static and visual checks separate."}],"occurrence_relations":[],"issues":[]}
