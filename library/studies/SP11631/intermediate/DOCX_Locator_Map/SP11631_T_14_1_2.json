rrences":[{"occurrence_id":"E00031O","docx_locator":"bookmark:E00031","source_text":"[4] Per-Protocol (PP) Analysis Set B:  All subjects from the Full Analysis Set without major protocol deviations, severe medication non-compliance, lost to follow-up or withdrawal in all\ncycles will be included in the PP Analysis Set B.","role":"footnote","panel_id":"P37","source_ref_ids":["EV00031"],"verification_status":"verified"}],"notes":"Native source occurrence; actual static and visual checks separate."},{"element_id":"E00032","element_type":"footnote","metadata_pointer":"/footnotes/5/exact_text","occurrences":[{"occurrence_id":"E00032O","docx_locator":"bookmark:E00032","source_text":"[5] Immunogenicity analysis set (IMAS) is defined as all subjects who receive at least one dose of F627 and have at least one result of serum anti-F-627 antibody collected after\ntreatment of F-627.","role":"footnote","panel_id":"P37","source_ref_ids":["EV00032"],"verification_status":"verified"}],"notes":"Native source occurrence; actual static and visual checks separate."}],"occurrence_relations":[],"issues":[]}
