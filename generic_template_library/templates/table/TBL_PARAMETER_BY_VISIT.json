      ]
    }
  ],
  "permitted_defaults": [
    {
      "path": "columns.stub_header",
      "value": "from preset",
      "status_when_used": "resolved",
      "basis": "House style stub header."
    },
    {
      "path": "row_blocks[parameter_visit].statistics",
      "value": [
        "n",
        "mean_sd",
        "median",
        "min_max"
      ],
      "status_when_used": "resolved",
      "basis": "House style statistic set."
    },
    {
      "path": "row_blocks[parameter_visit].categories",
      "value": "from preset",
      "status_when_used": "needs_review",
      "basis": "Assessment categories distilled from sources."
    }
  ],
  "editable_elements": [
    "title",
    "population",
    "columns.groups[].label",
