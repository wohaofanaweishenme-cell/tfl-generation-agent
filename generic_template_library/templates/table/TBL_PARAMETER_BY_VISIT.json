  "config_options": {
    "column_layout": {
      "values": [
        "groups",
        "single_all_subjects"
      ],
      "default": "groups",
      "description": "Group columns, or one all-subjects column for single-arm summaries."
    },
    "change_from_baseline": {
      "values": [
        true,
        false
      ],
      "default": true,
      "description": "Add change-from-baseline statistics under each post-baseline visit (continuous cells only)."
    }
  },
  "presets": [
