{
  "template_id": "TBL_RESPONSE_RATE",
  "version": "1.0.0",
  "output_type": "table",
  "name": "Response / incidence rate endpoint",
  "structural_signature": {
    "S1": "table",
    "S2": "ENDPOINT_ANALYSIS",
    "S3": [
      "GROUPS",
      "GROUPS_PLUS_COMPARISON",
      "SINGLE"
