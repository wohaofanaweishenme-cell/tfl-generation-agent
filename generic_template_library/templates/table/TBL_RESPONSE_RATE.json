      "NONE",
      "BY_PERIOD",
      "BY_GROUP_BLOCK"
    ]
  },
  "intended_use": "Binary or categorical endpoint: distribution of response categories, rate n (%) with confidence interval, and optionally a between-group estimate (difference, odds ratio) and test.",
  "not_for": "Time-to-event endpoints (time-to-event template); continuous endpoints with model estimates (continuous comparison template); plain category distributions without CI (variable summary template).",
  "keywords": [
    "response rate",
    "incidence rate"
  ],
  "aliases": [
    "objective response rate",
    "ORR",
    "disease control rate",
    "DCR",
    "clinical benefit rate",
    "best overall response",
    "BOR",
    "pCR rate",
    "incidence of",
    "landmark",
    "rate"
  ],
  "match_cues": {
    "title_terms": [
      "response rate",
      "control rate",
      "benefit rate",
      "best overall response",
      "pcr rate",
      "rate",
      "incidence of",
      "landmark"
    ],
    "negative_terms": [
      "listing",
      "plot",
      "kaplan",
      "duration of",
      "by visit",
      "system organ class"
    ]
  },
  "required_fields": [
    {
      "path": "title",
      "label": "Output title",
      "allowed_sources": [
        "content_list"
      ]
    },
    {
      "path": "population",
      "label": "Analysis population",
      "allowed_sources": [
        "content_list",
        "study_setting"
      ]
    },
    {
      "path": "columns.groups",
      "label": "Treatment groups / cohorts",
      "allowed_sources": [
        "study_setting"
      ]
    },
    {
      "path": "columns.total",
      "label": "Total column on/off and membership",
      "allowed_sources": [
        "study_setting"
      ]
    },
    {
      "path": "row_blocks[endpoint].items",
      "label": "Response categories and rate definition",
      "allowed_sources": [
        "content_list",
        "study_setting"
      ]
    },
    {
      "path": "footnotes[FN_CI]",
      "label": "Confidence-interval method and level",
      "allowed_sources": [
        "study_setting"
      ]
    },
    {
      "path": "columns.comparison_columns",
      "label": "Between-group estimate and test labels",
      "allowed_sources": [
        "study_setting"
      ],
      "description": "From study settings 'comparisons.response_rate' (estimate label, test label, method); never defaulted."
    }
  ],
  "permitted_defaults": [
    {
      "path": "columns.stub_header",
      "value": "from preset",
      "status_when_used": "resolved",
      "basis": "House style stub header."
    },
    {
      "path": "row_blocks[endpoint].items",
      "value": "from preset",
      "status_when_used": "needs_review",
      "basis": "Endpoint row structure distilled from sources."
    }
  ],
  "editable_elements": [
    "title",
    "population",
    "columns.groups[].label",
    "columns.total",
    "columns.comparison_columns",
    "row_blocks[].items",
    "footnotes",
    "programming_notes",
    "config"
  ],
  "config_options": {
    "column_layout": {
      "values": [
        "groups",
        "single_all_subjects"
      ],
      "default": "groups",
      "description": "Group columns, or one all-subjects column for single-arm summaries."
    },
    "comparison": {
      "values": [
        "none",
        "columns",
        "rows"
      ],
      "default": "none",
      "description": "Between-group comparison shown as extra columns, as extra rows, or not at all. Enabled only when study settings confirm a comparison.",
      "setting_path": "comparisons.response_rate"
    },
    "repeat_by_period": {
      "values": [
        false,
        true
      ],
      "default": false,
      "description": "Repeat the endpoint block per cycle/period.",
      "cues": {
        "true": [
          "cycle 2-4",
          "all treatment periods",
          "by cycle"
        ]
      }
    }
  },
  "presets": [
    "best_overall_response",
    "binary_rate"
  ],
  "skeleton": {
    "columns": {
      "stub_header": "Endpoint"
    },
    "footnotes": [
