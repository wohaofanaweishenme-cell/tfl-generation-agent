  "config_options": {
    "overlay_points": {
      "values": [
        true,
        false
      ],
      "default": true,
      "description": "Overlay individual subject values."
    }
  },
  "presets": [
    "change_from_baseline_box"
  ],
  "skeleton": {
    "figure": {
      "plot_type": "BOX",
      "x_axis": {
        "label": "Treatment group"
      },
      "y_axis": {
        "label": "[Measure] change from baseline at [time point] (%)"
      },
      "reference_lines": [
        "y = 0"
      ]
    },
    "footnotes": [
      {
        "id": "FN_BOX",
        "marker": null,
        "text": "Box: 25th to 75th percentile; line: median; marker: mean; whiskers: {settings:definitions.whisker_rule}."
      }
    ]
  },
  "figure_plot": {
    "plot_type": "BOX",
    "plotter": "renderer/figure/shells.py:plot_box",
    "data_contract": {
