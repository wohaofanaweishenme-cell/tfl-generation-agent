    ],
    "S6": "BOX"
  },
  "intended_use": "Distribution of a continuous value (typically change or percent change from baseline at one time point) by group: box (quartiles), median line, whiskers, optional mean marker and individual points.",
  "not_for": "Values over time (summary-over-time figure).",
  "keywords": [
    "box plot"
  ],
  "aliases": [
    "box plot",
    "boxplot",
    "box and whisker"
  ],
  "match_cues": {
    "title_terms": [
      "box plot",
      "boxplot"
    ],
    "negative_terms": [
      "spider",
      "waterfall",
      "kaplan"
    ]
  },
  "required_fields": [
    {
      "path": "title",
      "label": "Output title",
      "allowed_sources": [
        "content_list"
      ]
    },
    {
      "path": "population",
      "label": "Analysis population",
      "allowed_sources": [
        "content_list",
        "study_setting"
      ]
    },
    {
      "path": "figure.legend",
      "label": "Groups shown",
      "allowed_sources": [
        "study_setting"
      ]
    },
    {
      "path": "figure.y_axis.label",
      "label": "Measure, time point and unit",
      "allowed_sources": [
        "content_list",
        "study_setting"
      ]
    }
  ],
  "permitted_defaults": [
    {
      "path": "footnotes[FN_BOX]",
      "value": "box/whisker definition",
      "status_when_used": "needs_review",
      "basis": "Whisker rule must match the programming convention."
    }
  ],
  "editable_elements": [
    "title",
    "population",
