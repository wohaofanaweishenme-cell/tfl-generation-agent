{
  "template_id": "LST_SUBJECT_RECORDS",
  "version": "1.0.0",
  "output_type": "listing",
  "name": "Subject record listing",
  "structural_signature": {
    "S1": "listing",
    "S2": "SUBJECT_RECORDS",
    "S3": [
      "RECORD_FIELDS"
    ],
    "S4": [
      "RAW_VALUES"
    ],
    "S5": [
      "LISTING_SUBJECT",
      "LISTING_SUBJECT_EVENT",
      "LISTING_SUBJECT_VISIT",
      "LISTING_SUBJECT_PARAM_VISIT"
    ]
  },
  "intended_use": "Any subject-level data listing: one row per subject, per subject and record, per subject and visit (wide) or per subject, parameter and visit (long), with configurable fields, stacked cells, group headers and column panels.",
  "not_for": "Summary tables; catalogs that do not list subjects (e.g. protocol eligibility criteria text).",
  "keywords": [
    "subject listing"
  ],
  "aliases": [
    "listing",
    "listing of",
    "by subject",
    "records",
    "data"
  ],
  "match_cues": {
    "title_terms": [
      "listing"
    ],
    "negative_terms": [
      "number (%)",
      "plot",
      "preface"
    ]
  },
  "required_fields": [
    {
      "path": "title",
      "label": "Output title",
      "allowed_sources": [
        "content_list"
      ]
    },
    {
      "path": "population",
      "label": "Analysis population",
      "allowed_sources": [
        "content_list",
        "study_setting"
      ]
    },
    {
      "path": "listing.fields",
      "label": "Fields shown",
      "allowed_sources": [
        "content_list",
        "study_setting"
      ],
      "description": "Preset gives candidate fields from source listings; final list must match the CRF/ADaM."
    },
    {
      "path": "listing.sort_keys",
      "label": "Sort order",
      "allowed_sources": [
        "study_setting",
        "content_list"
      ]
    }
  ],
  "permitted_defaults": [
    {
      "path": "listing.fields",
      "value": "from preset",
      "status_when_used": "needs_review",
      "basis": "Fields present in >= 2 source studies of the topic."
    },
    {
      "path": "listing.record_grain",
      "value": "from preset",
      "status_when_used": "needs_review",
      "basis": "Most frequent grain among the topic's sources."
    },
    {
      "path": "listing.group_by",
      "value": [
        "Treatment group"
      ],
      "status_when_used": "needs_review",
      "basis": "Group header or group column in all six studies."
    },
    {
      "path": "listing.repeat_identifiers",
      "value": [
        "Subject ID",
        "Treatment group"
      ],
      "status_when_used": "resolved",
      "basis": "House style: identifiers repeated on every panel."
    }
  ],
  "editable_elements": [
    "title",
    "population",
    "listing.fields",
    "listing.sort_keys",
    "listing.group_by",
    "listing.record_grain",
    "footnotes",
    "programming_notes"
  ],
  "config_options": {
    "group_display": {
      "values": [
        "header_rows",
        "column"
      ],
      "default": "header_rows",
      "description": "Treatment group as page/section header rows, or as the first column."
    }
  },
  "presets": [
    "adverse_event_records",
    "analysis_set_records",
    "death_records",
    "demographic_records",
    "deviation_records",
    "disease_history_records",
    "disposition_records",
    "ecg_cardiac_records",
    "efficacy_records",
    "eligibility_records",
    "exposure_records",
    "immunogenicity_records",
    "laboratory_records",
    "medical_history_records",
    "medication_records",
    "pd_biomarker_records",
    "performance_status_records",
    "physical_exam_records",
    "pk_records",
    "questionnaire_records",
    "time_to_event_records",
    "visit_date_records",
    "vital_sign_records"
  ],
  "skeleton": {
    "columns": {
      "stub_header": ""
    },
    "footnotes": [
      {
        "id": "FN_STUDYDAY",
        "marker": null,
        "text": "Study day: {settings:definitions.study_day_definition}"
      }
    ],
    "programming_notes": [
      {
        "id": "PN_SORT",
        "marker": null,
        "text": "Sort by {sort_keys}."
      }
    ]
  },
